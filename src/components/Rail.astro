---
import { ALL_MODULES, ORDER, href, moduleHref, stopHref } from "../data/curriculum";
import { readySlugs } from "../lib/lessons";

interface Props { current: { module?: string; stop?: string; page?: string } }
const { current } = Astro.props;
const ready = await readySlugs();
const allSlugs = ORDER.map((l) => l.slug).join(",");
---
<nav class="rail" id="rail" aria-label="Course" transition:persist="rail">
  <a class="rail-home" href={href("/")} aria-current={current.page === "home" ? "page" : undefined}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 11l8-7 8 7v9h-5v-6H9v6H4z" /></svg>The route map
  </a>
  {ALL_MODULES.map((m) => {
    const here = current.module === m.slug;
    const isProj = m.kind === "projects";
    return (
      <details class="mod" data-track={m.track} data-module={m.slug} open={here}>
        <summary>
          <span class="mod-num" data-progress={isProj ? undefined : m.lessons.map((l) => l.slug).join(",")} aria-hidden="true">{m.id}</span>
          <span class="mod-title">{isProj ? "" : <span class="sr">Module {m.id}: </span>}{m.title}</span>
          <svg class="mod-caret" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
        </summary>
        <ul class="stops">
          <li class="stop overview">
            <a href={moduleHref(m)} aria-current={here && !current.stop ? "page" : undefined}><span class="stop-dot"></span>Overview</a>
          </li>
          {m.lessons.map((l) => {
            const soon = !ready.has(l.slug);
            return (
              <li class:list={["stop", { soon }]} data-stop={l.slug}>
                <a href={stopHref(m, l.slug)} aria-current={current.stop === l.slug ? "page" : undefined}>
                  <span class="stop-dot"></span>{l.title}{soon && <span class="sr"> (being written)</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    );
  })}
  <div class="rail-foot">
    <b data-progress-count={allSlugs} data-total={ORDER.length}>0 of {ORDER.length}</b> lessons done
    <div class="meter" aria-hidden="true"><i data-progress-meter></i></div>
    <ul>
      <li><a href={href("/glossary/")}>Glossary</a></li>
      <li><a href={href("/cheat-sheets/")}>Cheat sheets</a></li>
      <li><a href={href("/which-lesson/")}>Which lesson do I need?</a></li>
    </ul>
  </div>
</nav>
<script>
  import { onPage } from "../scripts/page";

  /* The rail stays mounted between pages (no re-render, no jump). After each
     navigation, move the "you are here" marker and open the current module. */
  const rail = document.getElementById("rail")!;
  let first = true;

  /* The router moves the rail into the new page, and moving an element resets
     its scroll position. Remember it across the swap. */
  let saved = 0;
  document.addEventListener("astro:before-swap", () => { saved = rail.scrollTop; });
  document.addEventListener("astro:after-swap", () => { rail.scrollTop = saved; });
  onPage(() => {
    const main = document.getElementById("main")!;
    const mod = main.dataset.module;
    const stop = main.dataset.stop;
    const page = main.dataset.page;
    rail.querySelectorAll("[aria-current]").forEach((a) => a.removeAttribute("aria-current"));
    let cur: HTMLElement | null = null;
    if (page === "home") cur = rail.querySelector(".rail-home");
    else if (mod) {
      const details = rail.querySelector<HTMLDetailsElement>(`details[data-module="${mod}"]`);
      if (details) {
        details.open = true;
        cur = stop
          ? details.querySelector(`[data-stop="${stop}"] a`)
          : details.querySelector(".stop.overview a");
      }
    }
    cur?.setAttribute("aria-current", "page");

    /* Keep the current stop in view. On the first load, centre it. After
       that, never jump: scroll only as far as needed, and only if it's cut off. */
    if (cur && cur !== rail.querySelector(".rail-home")) {
      const r = cur.getBoundingClientRect(), box = rail.getBoundingClientRect();
      const pad = 16;
      let delta = 0;
      if (first) delta = r.top - box.top - rail.clientHeight / 2;
      else if (r.top < box.top + pad) delta = r.top - box.top - pad;
      else if (r.bottom > box.bottom - pad) delta = r.bottom - box.bottom + pad;
      if (delta) rail.scrollTop += delta;
    }
    first = false;
  });
</script>
