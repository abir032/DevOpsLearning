---
/* A common mistake: the error, why it happened, and the fix. */
interface Props { title: string }
const { title } = Astro.props;
---
<aside class="mistake" aria-label={`Common mistake: ${title}`}>
  <div class="t">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 3 2 20h20L12 3z" /><path d="M12 10v4M12 17v.5" /></svg>
    <span>Common mistake: {title}</span>
  </div>
  <div class="b"><slot /></div>
</aside>
