---
/*
 * The cost badge at the top of every lab.
 *   free     — nothing in this lab costs money
 *   pennies  — a few cents at most
 *   paid     — costs money while it runs; delete it after
 */
interface Props { kind: "free" | "pennies" | "paid" }
const { kind } = Astro.props;
const label = { free: "Free", pennies: "Pennies", paid: "Costs money" }[kind];
---
<p class:list={["cost", kind]}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M14.8 9.2c-.5-.9-1.6-1.4-2.8-1.4-1.6 0-2.8.8-2.8 2s1.2 1.7 2.8 2.1 2.9.9 2.9 2.2-1.3 2.1-2.9 2.1c-1.3 0-2.4-.6-2.9-1.5M12 6v1.8M12 16.2V18" /></svg>
  <span><b>{label}</b> — <slot /></span>
</p>
