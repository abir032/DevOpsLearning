---
/*
 * Secrets: follow a password from the editor to the running app.
 * Teaches: every place a secret is written down is a place it can leak,
 * and every one of those places has to change when you rotate it.
 */
const STOPS = [
  { name: "Your editor", sub: "where the code is written" },
  { name: "Git history", sub: "every clone, forever" },
  { name: "The build", sub: "CI logs and the app package" },
  { name: "Server settings", sub: "launch template and user data" },
  { name: "The running app", sub: "in memory while it runs" },
];
---
<div class="viz" data-track="cloud" data-viz="secret-trail">
  <div class="viz-controls">
    <span class="lbl" id="st-lbl">The database password lives</span>
    <div class="seg" role="group" aria-labelledby="st-lbl">
      <button type="button" data-where="code" aria-pressed="true">In the code</button>
      <button type="button" data-where="env" aria-pressed="false">In server settings</button>
      <button type="button" data-where="sm" aria-pressed="false">In Secrets Manager</button>
    </div>
    <button class="btn line" type="button" data-act="trace">Follow the password</button>
    <button class="btn" type="button" data-act="rotate">Change the password</button>
    <button class="btn" type="button" data-act="reset">Reset</button>
  </div>
  <div class="st-stage">
    <ol class="st-list">
      {STOPS.map((s, i) => (
        <li class="st-stop" data-i={i}>
          <span class="st-dot" aria-hidden="true"></span>
          <div class="st-place"><b>{s.name}</b><small>{s.sub}</small></div>
          <p class="st-what">Not reached yet</p>
        </li>
      ))}
    </ol>
    <p class="st-tally"><span>Readable copies of the password: <b data-n="copies">0</b></span><span>Places to change when it changes: <b data-n="places">–</b></span></p>
  </div>
  <div class="viz-say" aria-live="polite"><span class="step-l">Ready</span>Choose where the password lives, then <b>Follow the password</b> from the editor to the running app.</div>
</div>

<style is:global>
  [data-viz="secret-trail"] .st-stage { padding: 14px 16px 6px; }
  [data-viz="secret-trail"] .st-list { list-style: none; margin: 0; padding: 0; position: relative; }
  [data-viz="secret-trail"] .st-list::before { content: ""; position: absolute; left: 9px; top: 14px; bottom: 14px; width: 4px; border-radius: 2px; background: var(--line); opacity: .35; }
  [data-viz="secret-trail"] .st-stop { position: relative; display: grid; grid-template-columns: 22px minmax(0, 11rem) minmax(0, 1fr); gap: 4px 14px; align-items: start; padding: 9px 0; }
  [data-viz="secret-trail"] .st-dot { width: 22px; height: 22px; border-radius: 50%; background: var(--surface); border: 4px solid var(--rule-2); margin-top: 1px; position: relative; z-index: 1; transition: border-color .2s, background .2s; }
  [data-viz="secret-trail"] .st-place b { display: block; font-size: 15px; line-height: 1.3; }
  [data-viz="secret-trail"] .st-place small { display: block; font-size: 13px; color: var(--ink-3); line-height: 1.35; }
  [data-viz="secret-trail"] .st-what { margin: 0; font-size: 14.5px; color: var(--ink-3); line-height: 1.45; padding: 6px 10px; border-radius: 8px; border: 1px solid transparent; }
  [data-viz="secret-trail"] .st-stop.here .st-dot { border-color: var(--line); }
  [data-viz="secret-trail"] .st-stop.bad .st-dot { border-color: var(--bad); background: var(--bad-bg); }
  [data-viz="secret-trail"] .st-stop.bad .st-what { color: var(--ink); background: var(--bad-bg); border-color: var(--bad); }
  [data-viz="secret-trail"] .st-stop.warn .st-dot { border-color: var(--warn); background: var(--warn-bg); }
  [data-viz="secret-trail"] .st-stop.warn .st-what { color: var(--ink); background: var(--warn-bg); border-color: var(--warn); }
  [data-viz="secret-trail"] .st-stop.ok .st-dot { border-color: var(--ok); background: var(--ok-bg); }
  [data-viz="secret-trail"] .st-stop.ok .st-what { color: var(--ink); background: var(--ok-bg); border-color: var(--ok); }
  [data-viz="secret-trail"] .st-stop.rot .st-what { box-shadow: 0 0 0 3px color-mix(in srgb, var(--line) 30%, transparent); }
  [data-viz="secret-trail"] .st-tally { max-width: none; display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 6px 0 8px; padding-top: 10px; border-top: 1px dashed var(--rule-2); font-size: 14.5px; color: var(--ink-2); }
  [data-viz="secret-trail"] .st-tally b { color: var(--ink); font-size: 16px; }
  @media (max-width: 620px) {
    [data-viz="secret-trail"] .st-stop { grid-template-columns: 22px minmax(0, 1fr); }
    [data-viz="secret-trail"] .st-what { grid-column: 2; }
  }
</style>

<script>
  import { beat, press, tell } from "../../scripts/viz";
  import { onPage, once } from "../../scripts/page";

  type Tone = "bad" | "warn" | "ok";
  type Where = "code" | "env" | "sm";
  interface Plan { label: string; stops: [Tone, string][]; rotate: string; places: number[]; count: number }

  const PLANS: Record<Where, Plan> = {
    code: {
      label: "in the code",
      stops: [
        ["bad", "Typed into <code>config.py</code> as plain text."],
        ["bad", "Pushed with the code. Every clone has it, and the history keeps it even after you delete the line."],
        ["bad", "Packed into every build of the app. Anyone who can download a build can read it."],
        ["bad", "Travels inside the app package onto every server."],
        ["ok", "In the app's memory. That part is normal — the app needs it to connect."],
      ],
      rotate: "To change it you edit the code, rebuild and redeploy every server. And the <b>old password is still in git history</b>, readable by anyone who has ever cloned the repository.",
      places: [0, 1, 2, 3],
      count: 4,
    },
    env: {
      label: "in server settings",
      stops: [
        ["ok", "Nothing in the code. It reads <code>DB_PASSWORD</code> from the environment."],
        ["ok", "Git never sees it."],
        ["ok", "The build never sees it."],
        ["bad", "Typed into the launch template's user data. Anyone allowed to view the template or the server's settings can read it, and <b>every old template version keeps a copy</b>."],
        ["warn", "In the process environment. Error pages and crash reports that dump the environment will print it."],
      ],
      rotate: "Better than the code: git is clean. But you still make a new launch template version and <b>replace every server</b>, and the old versions still show the old password.",
      places: [3, 4],
      count: 2,
    },
    sm: {
      label: "in Secrets Manager",
      stops: [
        ["ok", "The code only holds the secret's <b>name</b>: <code>quickcart/dev/db</code>."],
        ["ok", "Git only ever sees the name. A name is useless without permission to read it."],
        ["ok", "The build only sees the name."],
        ["ok", "The server gets an IAM role that may read that one secret. No password anywhere in its settings."],
        ["ok", "At start, the app asks Secrets Manager for the value. IAM checks the role, CloudTrail records the read, and the value only ever lives in memory."],
      ],
      rotate: "You change it <b>in one place</b>. Apps get the new value the next time they fetch it. Nothing to rebuild, no server to replace, and no old copy lying in git.",
      places: [],
      count: 1,
    },
  };

  onPage(() => {
    const halts: (() => void)[] = [];
    document.querySelectorAll<HTMLElement>('[data-viz="secret-trail"]').forEach((root) => {
    if (!once(root)) return;
    const say = root.querySelector<HTMLElement>(".viz-say")!;
    const stops = [...root.querySelectorAll<HTMLElement>(".st-stop")];
    const copies = root.querySelector<HTMLElement>('[data-n="copies"]')!;
    const places = root.querySelector<HTMLElement>('[data-n="places"]')!;
    const whereBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-where]")];
    let where: Where = "code";
    let run = 0; /* bumped on every new action, so an old trace stops narrating */

    function clear() {
      stops.forEach((s) => {
        s.className = "st-stop";
        s.querySelector(".st-what")!.textContent = "Not reached yet";
      });
      copies.textContent = "0";
      places.textContent = "–";
    }
    function show(i: number) {
      const [tone, html] = PLANS[where].stops[i];
      stops[i].className = "st-stop here " + tone;
      stops[i].querySelector(".st-what")!.innerHTML = html;
    }
    function countCopies() {
      return PLANS[where].stops.filter(([t]) => t !== "ok").length;
    }
    function busy(on: boolean) {
      root.querySelectorAll<HTMLButtonElement>("[data-where],[data-act=trace],[data-act=rotate]").forEach((b) => (b.disabled = on));
    }

    async function trace() {
      const me = ++run; busy(true); clear();
      const p = PLANS[where];
      for (let i = 0; i < stops.length; i++) {
        show(i);
        copies.textContent = String(p.stops.slice(0, i + 1).filter(([t]) => t !== "ok").length);
        tell(say, `Stop ${i + 1} of 5: ${stops[i].querySelector("b")!.textContent}`, p.stops[i][1], p.stops[i][0] === "ok" ? "" : "bad");
        await beat(1100);
        if (me !== run) return;
      }
      const n = countCopies();
      tell(say, n ? `${n} risky ${n === 1 ? "copy" : "copies"}` : "No risky copies",
        n
          ? `With the password ${p.label}, it ended up written down in <b>${n} places</b> other people can read. Each one is a place it can leak. Now try <b>Change the password</b>.`
          : `With the password ${p.label}, it is <b>never written down</b> anywhere except Secrets Manager itself. Now try <b>Change the password</b>.`,
        n ? "bad" : "good");
      busy(false);
    }

    function rotate() {
      run++; busy(false);
      const p = PLANS[where];
      clear();
      p.stops.forEach((_, i) => show(i));
      p.places.forEach((i) => stops[i].classList.add("rot"));
      copies.textContent = String(countCopies());
      places.textContent = String(p.count);
      tell(say, `Changing it: ${p.count} ${p.count === 1 ? "place" : "places"}`, p.rotate, p.count > 1 ? "bad" : "good");
    }

    root.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
      if (!b || b.disabled) return;
      if (b.dataset.where) {
        run++; busy(false);
        where = b.dataset.where as Where;
        press(whereBtns, (x) => x === b);
        clear();
        tell(say, "The password lives " + PLANS[where].label, "Choose <b>Follow the password</b> to see every place it gets written down.");
      } else if (b.dataset.act === "trace") trace();
      else if (b.dataset.act === "rotate") rotate();
      else if (b.dataset.act === "reset") {
        run++; busy(false); clear();
        tell(say, "Ready", "Choose where the password lives, then <b>Follow the password</b>.");
      }
    });
    halts.push(() => { run++; });
    });
    /* leaving the page: stop narrating any trace in flight */
    return () => halts.forEach((h) => h());
  });
</script>
