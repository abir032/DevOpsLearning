---
/*
 * Why Terraform: the same environment built by clicking and by code.
 * Teaches: the second copy is where clicking falls behind and misses a step.
 */
import { sideHtml, sayHtml } from "../../scripts/tf-click-vs-code";
---
<div class="viz" data-track="code" data-viz="tf-click-vs-code">
  <div class="viz-controls">
    <button class="btn line" type="button" data-a="build">Build it once</button>
    <button class="btn" type="button" data-a="copy" disabled>Build a second copy in eu-west-1</button>
    <button class="btn" type="button" data-a="reset">Start again</button>
  </div>
  <div class="cvc">
    <div class="cvc-col" data-side="click" set:html={sideHtml("click", 0)} />
    <div class="cvc-col" data-side="code" set:html={sideHtml("code", 0)} />
  </div>
  <div class="viz-say" aria-live="polite" set:html={sayHtml(0)} />
</div>

<style is:global>
  [data-viz="tf-click-vs-code"] .cvc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 14px 16px; }
  [data-viz="tf-click-vs-code"] .cvc-col { border: 1px solid var(--rule); border-radius: 10px; padding: 12px; background: var(--bg); }
  [data-viz="tf-click-vs-code"] .cvc-col h3 { margin: 0 0 2px; font-size: 15px; font-weight: 800; }
  [data-viz="tf-click-vs-code"] .cvc-col small { display: block; color: var(--ink-3); font-size: 12.5px; margin-bottom: 10px; }
  [data-viz="tf-click-vs-code"] .cvc-regions { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
  [data-viz="tf-click-vs-code"] .cvc-region { border: 1px dashed var(--rule-2); border-radius: 8px; padding: 8px; min-height: 60px; }
  [data-viz="tf-click-vs-code"] .cvc-rn { font-family: var(--mono); font-size: 12.5px; font-weight: 600; color: var(--ink-2); margin-bottom: 6px; }
  [data-viz="tf-click-vs-code"] .cvc-empty { font-size: 13px; color: var(--ink-3); }
  [data-viz="tf-click-vs-code"] .chip { font-size: 13px; padding: 4px 8px; margin-bottom: 4px; }
  [data-viz="tf-click-vs-code"] .cvc-facts { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 10px; margin: 12px 0 0; font-size: 14px; }
  [data-viz="tf-click-vs-code"] .cvc-facts dt { font-weight: 700; color: var(--ink-2); }
  [data-viz="tf-click-vs-code"] .cvc-facts dd { margin: 0; }
  @media (max-width: 760px) {
    [data-viz="tf-click-vs-code"] .cvc { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { PIECES, sideHtml, sayHtml, SAY, type Stage } from "../../scripts/tf-click-vs-code";
  import { reduced } from "../../scripts/viz";
  import { onPage, once } from "../../scripts/page";

  onPage(() => {
    const stops: (() => void)[] = [];
    document.querySelectorAll<HTMLElement>('[data-viz="tf-click-vs-code"]').forEach((root) => {
      if (!once(root)) return;
      const click = root.querySelector<HTMLElement>('[data-side="click"]')!;
      const code = root.querySelector<HTMLElement>('[data-side="code"]')!;
      const say = root.querySelector<HTMLElement>(".viz-say")!;
      const build = root.querySelector<HTMLButtonElement>('[data-a="build"]')!;
      const copy = root.querySelector<HTMLButtonElement>('[data-a="copy"]')!;
      let stage: Stage = 0;
      let timer: ReturnType<typeof setInterval> | null = null;

      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
      }
      function finish(s: Stage) {
        stop();
        stage = s;
        click.innerHTML = sideHtml("click", s);
        code.innerHTML = sideHtml("code", s);
        say.className = "viz-say" + (SAY[s].tone ? " " + SAY[s].tone : "");
        say.innerHTML = sayHtml(s);
        build.disabled = s !== 0;
        copy.disabled = s !== 1;
      }
      /* Clicking builds one piece at a time; code appears in one apply. */
      function go(s: Stage) {
        stop();
        build.disabled = true;
        copy.disabled = true;
        if (reduced()) { finish(s); return; }
        const n = PIECES.length;
        let k = 0;
        say.className = "viz-say";
        say.innerHTML = `<span class="step-l">Building</span>${s === 1 ? "Both sides build QuickCart's environment in us-east-1." : "Both sides build a second copy in eu-west-1."}`;
        timer = setInterval(() => {
          k++;
          const full = PIECES.length;
          const codeN = k >= 3 ? full : 0;
          if (s === 1) {
            click.innerHTML = sideHtml("click", 0, k, 0);
            code.innerHTML = sideHtml("code", 0, codeN, 0);
          } else {
            click.innerHTML = sideHtml("click", 2, full, k);
            code.innerHTML = sideHtml("code", 2, full, codeN);
          }
          if (k >= n) finish(s);
        }, 260);
      }

      root.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
        if (!b || b.disabled) return;
        if (b.dataset.a === "build") go(1);
        else if (b.dataset.a === "copy") go(2);
        else if (b.dataset.a === "reset") finish(0);
      });
      stops.push(stop);
    });
    return () => stops.forEach((s) => s());
  });
</script>
