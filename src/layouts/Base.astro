---
import "@fontsource/overpass/400.css";
import "@fontsource/overpass/600.css";
import "@fontsource/overpass/700.css";
import "@fontsource/overpass/800.css";
import "@fontsource/overpass-mono/400.css";
import "@fontsource/overpass-mono/600.css";
import "../styles/global.css";
import Rail from "../components/Rail.astro";
import Search from "../components/Search.astro";
import { ClientRouter } from "astro:transitions";
import { href } from "../data/curriculum";

interface Props {
  title: string;
  description: string;
  current?: { module?: string; stop?: string; page?: string };
  track?: string;
}
const { title, description, current = {}, track } = Astro.props;
const full = title === "Laptop to Production" ? title : `${title} — Laptop to Production`;
const nav = [
  ["The route", "/", "home"],
  ["Projects", "/projects/", "projects"],
  ["Glossary", "/glossary/", "glossary"],
  ["Which lesson?", "/which-lesson/", "which-lesson"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  <ClientRouter fallback="swap" />
  <script is:inline>
    /* Apply the saved theme before the first paint, so there is no flash. */
    try { var t = localStorage.getItem("ltp-theme"); if (t === "dark" || t === "light") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="topbar" transition:persist="topbar">
    <button class="iconbtn menubtn" id="menuBtn" type="button" aria-label="Open the course menu" aria-expanded="false" aria-controls="rail">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <a class="brand" href={href("/")}>
      <svg class="brand-mark" viewBox="0 0 26 26" aria-hidden="true"><path d="M4 22 V13 Q4 8 9 8 H22" fill="none" stroke="#1F64C8" stroke-width="3.2" stroke-linecap="round" /><path d="M4 22 V17" stroke="#D23B32" stroke-width="3.2" stroke-linecap="round" /><circle cx="4" cy="22" r="3" fill="#D23B32" /><circle cx="13" cy="8" r="3" fill="#fff" stroke="#0B9180" stroke-width="2.4" /><circle cx="22" cy="8" r="3" fill="#7446C9" /></svg>
      <span>Laptop to Production</span>
    </a>
    <nav class="topnav" aria-label="Site">
      {nav.map(([label, path, key]) => (
        <a href={href(path)} data-key={key} aria-current={current.page === key ? "page" : undefined}>{label}</a>
      ))}
    </nav>
    <span class="spacer"></span>
    <button class="iconbtn searchbtn" id="searchBtn" type="button" aria-haspopup="dialog" aria-keyshortcuts="/ Control+K Meta+K">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
      <span class="lbl">Search lessons and terms</span><span class="sr">Search</span><span class="kbd" aria-hidden="true">/</span>
    </button>
    <button class="iconbtn" id="themeBtn" type="button" aria-label="Switch theme">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </header>
  <div class="shell">
    <Rail current={current} />
    <main class="main" id="main" tabindex="-1" data-track={track} data-module={current.module} data-stop={current.stop} data-page={current.page} transition:animate="fade">
      <slot />
    </main>
  </div>
  <div class="scrim" id="scrim" aria-hidden="true" transition:persist="scrim"></div>
  <Search />
</body>
</html>

<style is:global>
  .i-sun { display: none; }
  :root[data-theme="dark"] .i-sun { display: block; }
  :root[data-theme="dark"] .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .i-sun { display: block; }
    :root:not([data-theme="light"]) .i-moon { display: none; }
  }
</style>

<script>
  import { applyProgress } from "../scripts/progress";
  import { applySavedTheme, isDark, toggleTheme } from "../scripts/theme";
  import { onPage } from "../scripts/page";

  /* The top bar, rail and search stay mounted between pages; only <main>
     is swapped. So this script runs once, and page-level work goes in onPage. */

  /* theme: the router copies <html> attributes from the new page, so put
     the saved choice back before it paints */
  document.addEventListener("astro:after-swap", applySavedTheme);
  const themeBtn = document.getElementById("themeBtn")!;
  const label = () => themeBtn.setAttribute("aria-label", isDark() ? "Switch to light theme" : "Switch to dark theme");
  themeBtn.addEventListener("click", () => { toggleTheme(); label(); });
  label();

  /* mobile drawer */
  const rail = document.getElementById("rail")!;
  const scrim = document.getElementById("scrim")!;
  const menu = document.getElementById("menuBtn")!;
  function setMenu(open: boolean) {
    rail.classList.toggle("open", open);
    scrim.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-label", open ? "Close the course menu" : "Open the course menu");
    if (open) (rail.querySelector('[aria-current="page"]') as HTMLElement || rail.querySelector("a") as HTMLElement)?.focus();
  }
  menu.addEventListener("click", () => setMenu(!rail.classList.contains("open")));
  scrim.addEventListener("click", () => setMenu(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && rail.classList.contains("open")) { setMenu(false); menu.focus(); }
  });
  document.addEventListener("astro:before-swap", () => setMenu(false));

  /* top nav: mark the current section */
  onPage(() => {
    const page = document.getElementById("main")!.dataset.page;
    document.querySelectorAll<HTMLAnchorElement>(".topnav a").forEach((a) => {
      if (a.dataset.key === page) a.setAttribute("aria-current", "page"); else a.removeAttribute("aria-current");
    });
    applyProgress();

    /* A table that scrolls sideways must be reachable by keyboard, so it can
       be scrolled with the arrow keys. Only the ones that really overflow get
       a tab stop; the rest would just be noise. */
    document.querySelectorAll<HTMLElement>(".tbl").forEach((t) => {
      if (t.scrollWidth > t.clientWidth + 1) {
        t.tabIndex = 0;
        t.setAttribute("role", "region");
        t.setAttribute("aria-label", "Table, scrolls sideways");
      } else {
        t.removeAttribute("tabindex");
        t.removeAttribute("role");
        t.removeAttribute("aria-label");
      }
    });
  });

  /* copy buttons on every code block */
  document.addEventListener("click", async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".copy");
    if (!b) return;
    const pre = b.closest(".codewrap")?.querySelector("pre");
    if (!pre) return;
    try {
      await navigator.clipboard.writeText(pre.textContent || "");
      b.textContent = "Copied";
    } catch {
      /* Clipboard blocked: select the text so Ctrl/Cmd+C works. */
      const r = document.createRange(); r.selectNodeContents(pre);
      const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
      b.textContent = "Selected — press Ctrl+C";
    }
    setTimeout(() => (b.textContent = "Copy"), 1600);
  });

  /* print one cheat sheet */
  document.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest(".cheat-h .print");
    if (!b) return;
    document.body.classList.add("print-cheat");
    window.print();
  });
  window.addEventListener("afterprint", () => document.body.classList.remove("print-cheat"));
</script>
