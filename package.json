{
  "name": "laptop-to-production",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 4321",
    "check:code": "node scripts/check-code.mjs",
    "check:forbidden": "node scripts/check-forbidden.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "test": "npm run check:code && npm run check:contrast && npm run build && npm run check:forbidden && npm run check:links && npm run test:e2e",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@fontsource/overpass": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "astro": "^7.3.5",
    "hast-util-to-string": "^3.0.1",
    "shiki": "^4.4.3",
    "three": "^0.186.1",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2"
